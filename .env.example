# Configuração do PostgreSQL para Monitoramento CTO
# Opção 1: URL de Conexão Completa (exemplo: Supabase, Neon, Railway, Docker, Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoramento_cto

# Opção 2: Variáveis separadas (descomente para usar)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=monitoramento_cto
